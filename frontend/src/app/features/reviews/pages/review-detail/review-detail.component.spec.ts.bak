import {
  convertToParamMap,
  provideRouter,
} from '@angular/router';
import {
  ComponentFixture,
  TestBed,
} from '@angular/core/testing';
import { ActivatedRoute } from '@angular/router';
import {
  of,
  throwError,
  Subject,
} from 'rxjs';

import { Review } from '../../../../shared/models/reviews/review.model';
import { ReviewService } from '../../../../shared/services/reviews/review.service';

import { ReviewDetailComponent } from './review-detail.component';

describe('ReviewDetailComponent', () => {
  let fixture: ComponentFixture<ReviewDetailComponent>;
  let component: ReviewDetailComponent;

  const review: Review = {
    id: 'review-1',
    userId: 'user-1',
    type: 'confidence',
    status: 'pending',
    target: {
      documentId: 'document-1',
      documentExtractionId: 'extraction-1',
    },
    decision: null,
    reviewerId: 'user-1',
    notes: 'Low confidence field',
    createdAt: '2026-09-01T00:00:00Z',
    completedAt: null,
    supersedesReviewId: null,
  };

  const reviewWithExtraction: Review = {
    ...review,
    extraction: {
      id: 'extraction-1',
      provider: 'test',
      model: 'test-ocr',
      modelVersion: '1',
      extractionVersion: 'ocr-v1',
      schemaVersion: '1',
      status: 'completed',
      startedAt: '2026-09-01T00:00:00Z',
      completedAt: '2026-09-01T00:00:01Z',
      fields: {
        'transaction.total': {
          value: 125.5,
          confidence: 72,
          source: 'ocr',
        },
        'transaction.date': {
          value: '2026-08-31',
          confidence: 91,
          source: 'ocr',
        },
      },
    },
  };

  const reviewService = {
    getReview: vi.fn(() => of(review)),
    listReviews: vi.fn(),
    submitDecision: vi.fn(),
    submitCorrection: vi.fn(),
  };

  beforeEach(async () => {
    vi.clearAllMocks();

    reviewService.getReview.mockReturnValue(
      of(review),
    );

    await TestBed.configureTestingModule({
      imports: [ReviewDetailComponent],
      providers: [
        provideRouter([]),
        {
          provide: ActivatedRoute,
          useValue: {
            snapshot: {
              paramMap: convertToParamMap({
                id: 'review-1',
              }),
            },
          },
        },
        {
          provide: ReviewService,
          useValue: reviewService,
        },
      ],
    }).compileComponents();

    fixture =
      TestBed.createComponent(
        ReviewDetailComponent,
      );

    component =
      fixture.componentInstance;

    fixture.detectChanges();
  });

  it('should create', () => {
    expect(component).toBeTruthy();
  });

  it('should load the review from the route id', () => {
    expect(
      reviewService.getReview,
    ).toHaveBeenCalledWith(
      'review-1',
    );
  });

  it('should display the review status and type', () => {
    const element =
      fixture.nativeElement as HTMLElement;

    expect(
      element.textContent,
    ).toContain('pending');

    expect(
      element.textContent,
    ).toContain('confidence');
  });

  it('should submit an approved decision', () => {
    reviewService.submitDecision.mockReturnValue(
      of({
        ...review,
        status: 'completed',
        decision: 'approved',
        notes: 'Verified by reviewer',
        completedAt:
          '2026-09-01T01:00:00Z',
      }),
    );

    component.submitDecision(
      'approved',
      'Verified by reviewer',
    );

    expect(
      reviewService.submitDecision,
    ).toHaveBeenCalledWith(
      'review-1',
      {
        decision: 'approved',
        notes: 'Verified by reviewer',
      },
    );
  });

  it('should update the review after a successful decision', () => {
    const completedReview:
      Review = {
      ...review,
      status: 'completed',
      decision: 'approved',
      notes: 'Verified by reviewer',
      completedAt:
        '2026-09-01T01:00:00Z',
    };

    reviewService.submitDecision.mockReturnValue(
      of(completedReview),
    );

    component.submitDecision(
      'approved',
      'Verified by reviewer',
    );

    expect(
      component.review,
    ).toEqual(
      completedReview,
    );

    expect(
      component.isSubmitting,
    ).toBe(false);

    expect(
      component.decisionSuccess,
    ).toBe(true);

    expect(
      component.decisionError,
    ).toBeNull();
  });

  it('should prevent duplicate decision submission', () => {
    reviewService.submitDecision.mockReturnValue(
      of({
        ...review,
        status: 'completed',
        decision: 'approved',
      }),
    );

    component.isSubmitting = true;

    component.submitDecision(
      'approved',
    );

    expect(
      reviewService.submitDecision,
    ).not.toHaveBeenCalled();
  });

  it('should handle decision submission errors', () => {
    reviewService.submitDecision.mockReturnValue(
      throwError(
        () =>
          new Error(
            'Request failed',
          ),
      ),
    );

    component.submitDecision(
      'rejected',
      'Insufficient evidence',
    );

    expect(
      component.isSubmitting,
    ).toBe(false);

    expect(
      component.decisionSuccess,
    ).toBe(false);

    expect(
      component.decisionError,
    ).toBe(
      'Failed to submit review decision.',
    );
  });

  it('should reset previous decision state before submitting', () => {
    reviewService.submitDecision.mockReturnValue(
      of({
        ...review,
        status: 'completed',
        decision: 'approved',
      }),
    );

    component.decisionSuccess = true;
    component.decisionError =
      'Previous error';

    component.submitDecision(
      'approved',
    );

    expect(
      component.decisionError,
    ).toBeNull();

    expect(
      component.decisionSuccess,
    ).toBe(true);

    expect(
      component.isSubmitting,
    ).toBe(false);
  });

  it('should initialize correction values from extracted fields', () => {
    component.review =
      reviewWithExtraction;

    component[
      'initializeCorrectionValues'
    ]();

    expect(
      component.correctionValues[
        'transaction.total'
      ],
    ).toBe(125.5);

    expect(
      component.correctionValues[
        'transaction.date'
      ],
    ).toBe('2026-08-31');
  });

  it('should submit a correction for a pending review', () => {
    component.review =
      reviewWithExtraction;

    component.setCorrectionValue(
      'transaction.total',
      135.75,
    );

    reviewService.submitCorrection.mockReturnValue(
      of({
        review:
          reviewWithExtraction,
        evidence: {
          id: 'evidence-1',
          fieldPath:
            'transaction.total',
          extractedValue: {
            value: 135.75,
            source: 'reviewer',
          },
          evidenceType:
            'review_correction',
          sourceType:
            'document_extraction',
          status: 'active',
          verificationStatus:
            'verified',
          confidence: 100,
          verifiedAt:
            '2026-09-02T03:00:00Z',
        },
      }),
    );

    component.submitCorrection(
      'transaction.total',
    );

    expect(
      reviewService.submitCorrection,
    ).toHaveBeenCalledWith(
      'review-1',
      {
        fieldPath:
          'transaction.total',
        value: 135.75,
      },
    );

    expect(
      component.correctionSubmittingField,
    ).toBeNull();

    expect(
      component.correctionSuccessField,
    ).toBe(
      'transaction.total',
    );

    expect(
      component.correctionError,
    ).toBeNull();
  });

  it('should prevent duplicate correction submission', () => {
    component.review =
      reviewWithExtraction;

    component.correctionSubmittingField =
      'transaction.total';

    component.submitCorrection(
      'transaction.total',
    );

    expect(
      reviewService.submitCorrection,
    ).not.toHaveBeenCalled();
  });

  it('should prevent correction submission for completed reviews', () => {
    component.review = {
      ...reviewWithExtraction,
      status: 'completed',
    };

    component.setCorrectionValue(
      'transaction.total',
      135.75,
    );

    component.submitCorrection(
      'transaction.total',
    );

    expect(
      reviewService.submitCorrection,
    ).not.toHaveBeenCalled();
  });

  it('should handle correction submission errors', () => {
    component.review =
      reviewWithExtraction;

    component.setCorrectionValue(
      'transaction.total',
      135.75,
    );

    reviewService.submitCorrection.mockReturnValue(
      throwError(
        () =>
          new Error(
            'Request failed',
          ),
      ),
    );

    component.submitCorrection(
      'transaction.total',
    );

    expect(
      component.correctionSubmittingField,
    ).toBeNull();

    expect(
      component.correctionSuccessField,
    ).toBeNull();

    expect(
      component.correctionError,
    ).toBe(
      'Failed to submit review correction.',
    );
  });

  it('should render correction controls for extracted fields', () => {
    reviewService.getReview.mockReturnValue(
      of(reviewWithExtraction),
    );

    fixture.destroy();

    fixture =
      TestBed.createComponent(
        ReviewDetailComponent,
      );

    component =
      fixture.componentInstance;

    fixture.detectChanges();

    const element =
      fixture.nativeElement as HTMLElement;

    expect(
      component.review?.extraction,
    ).toBeTruthy();

    expect(
      element.textContent,
    ).toContain(
      'Document Extraction',
    );

    expect(
      element.textContent,
    ).toContain(
      'Extracted Fields',
    );

    expect(
      element.textContent,
    ).toContain(
      'Corrected value',
    );

    expect(
      element.textContent,
    ).toContain(
      'Save Correction',
    );

    expect(
      element.textContent,
    ).toContain(
      'transaction.total',
    );
  });

  it('should render Approve and Reject buttons for pending review', () => {
    const element =
      fixture.nativeElement as HTMLElement;

    const buttons =
      Array.from(
        element.querySelectorAll('button'),
      ).map((button) =>
        button.textContent?.trim(),
      );

    expect(buttons).toContain('Approve');
    expect(buttons).toContain('Reject');
  });

  it('should submit approved decision when Approve is clicked', () => {
    const completedReview: Review = {
      ...review,
      status: 'completed',
      decision: 'approved',
      notes: 'Verified by reviewer',
      completedAt:
        '2026-09-07T07:00:00Z',
    };

    reviewService.submitDecision.mockReturnValue(
      of(completedReview),
    );

    const element =
      fixture.nativeElement as HTMLElement;

    const textarea =
      element.querySelector(
        '#review-notes',
      ) as HTMLTextAreaElement;

    textarea.value =
      'Verified by reviewer';

    const approveButton =
      Array.from(
        element.querySelectorAll('button'),
      ).find(
        (button) =>
          button.textContent?.trim() ===
          'Approve',
      ) as HTMLButtonElement;

    expect(approveButton).toBeTruthy();

    approveButton.click();

    expect(
      reviewService.submitDecision,
    ).toHaveBeenCalledWith(
      'review-1',
      {
        decision: 'approved',
        notes: 'Verified by reviewer',
      },
    );

    expect(
      component.review,
    ).toEqual(
      completedReview,
    );
  });

  it('should submit rejected decision when Reject is clicked', () => {
    const completedReview: Review = {
      ...review,
      status: 'completed',
      decision: 'rejected',
      notes: 'Insufficient evidence',
      completedAt:
        '2026-09-07T07:00:00Z',
    };

    reviewService.submitDecision.mockReturnValue(
      of(completedReview),
    );

    const element =
      fixture.nativeElement as HTMLElement;

    const textarea =
      element.querySelector(
        '#review-notes',
      ) as HTMLTextAreaElement;

    textarea.value =
      'Insufficient evidence';

    const rejectButton =
      Array.from(
        element.querySelectorAll('button'),
      ).find(
        (button) =>
          button.textContent?.trim() ===
          'Reject',
      ) as HTMLButtonElement;

    expect(rejectButton).toBeTruthy();

    rejectButton.click();

    expect(
      reviewService.submitDecision,
    ).toHaveBeenCalledWith(
      'review-1',
      {
        decision: 'rejected',
        notes: 'Insufficient evidence',
      },
    );

    expect(
      component.review,
    ).toEqual(
      completedReview,
    );
  });

  it('should not render decision buttons for completed review', () => {
    reviewService.getReview.mockReturnValue(
      of({
        ...review,
        status: 'completed',
        decision: 'approved',
        completedAt: '2026-09-07T07:00:00Z',
      }),
    );

    fixture.destroy();

    fixture = TestBed.createComponent(
      ReviewDetailComponent,
    );

    component = fixture.componentInstance;

    fixture.detectChanges();

    const element =
      fixture.nativeElement as HTMLElement;

    const buttons =
      Array.from(
        element.querySelectorAll('button'),
      ).map((button) =>
        (button as HTMLButtonElement).textContent?.trim(),
      );

    expect(buttons).not.toContain('Approve');
    expect(buttons).not.toContain('Reject');
  });

  it('should submit correction when Save Correction is clicked', () => {
    reviewService.getReview.mockReturnValue(
      of(reviewWithExtraction),
    );

    fixture.destroy();

    fixture = TestBed.createComponent(
      ReviewDetailComponent,
    );

    component = fixture.componentInstance;

    fixture.detectChanges();

    const input = fixture.nativeElement.querySelector(
      'input[id^="correction-"]',
    ) as HTMLInputElement;

    expect(input).not.toBeNull();

    input.value = '150';
    input.dispatchEvent(new Event('input'));
    fixture.detectChanges();

    const buttons =
      Array.from(
        fixture.nativeElement.querySelectorAll('button'),
      ) as HTMLButtonElement[];

    const saveButton = buttons.find(
      (button) =>
        button.textContent?.trim() === 'Save Correction',
    );

    expect(saveButton).toBeDefined();

    reviewService.submitCorrection.mockReturnValue(
      of({
        review: {
          ...reviewWithExtraction,
          status: 'pending',
        },
        correctionEvidence: {
          id: 'correction-1',
          reviewId: 'review-1',
          fieldPath: 'transaction.total',
          correctedValue: 150,
        },
      }),
    );

    saveButton!.click();
    fixture.detectChanges();

    expect(
      reviewService.submitCorrection,
    ).toHaveBeenCalledWith(
      'review-1',
      {
        fieldPath: 'transaction.total',
        value: '150',
      },
    );
  });

  it('should disable correction controls while saving a correction', () => {
    reviewService.getReview.mockReturnValue(
      of(reviewWithExtraction),
    );

    fixture.destroy();

    fixture = TestBed.createComponent(
      ReviewDetailComponent,
    );

    component = fixture.componentInstance;

    fixture.detectChanges();

    const input = fixture.nativeElement.querySelector(
      'input[id^="correction-"]',
    ) as HTMLInputElement;

    expect(input).not.toBeNull();

    input.value = '150';
    input.dispatchEvent(new Event('input'));
    fixture.detectChanges();

    const buttons =
      Array.from(
        fixture.nativeElement.querySelectorAll('button'),
      ) as HTMLButtonElement[];

    const saveButton = buttons.find(
      (button) =>
        button.textContent?.trim() === 'Save Correction',
    );

    expect(saveButton).toBeDefined();

    reviewService.submitCorrection.mockImplementation(
      () =>
        new Subject<{
          review: Review;
          correctionEvidence: unknown;
        }>(),
    );

    saveButton!.click();
    fixture.detectChanges();

    const correctionInputs =
      Array.from(
        fixture.nativeElement.querySelectorAll(
          'input[id^="correction-"]',
        ),
      ) as HTMLInputElement[];

    expect(
      correctionInputs.every(
        (correctionInput) => correctionInput.disabled,
      ),
    ).toBe(true);

    expect(saveButton!.disabled).toBe(true);
  });
});


