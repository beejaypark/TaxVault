APP_NAME=TaxVault
APP_ENV=local
APP_KEY=

POSTGRES_DB=taxvault
POSTGRES_USER=taxvault
POSTGRES_PASSWORD=taxvault_dev

REDIS_PASSWORD=
OCR_PROVIDER=local

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
DEV_ADMIN_LOGIN_ENABLED=true

KEYCLOAK_URL=http://keycloak:8080/auth
KEYCLOAK_PUBLIC_URL=https://localhost:8443/auth
KEYCLOAK_REALM=taxvault
KEYCLOAK_CLIENT_ID=taxvault-web
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=https://localhost:8443/api/auth/oidc/callback

# Document encryption at rest (AES-256-GCM). Generate: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
# If empty, a key is derived from APP_KEY. Losing this key makes stored documents unrecoverable.
DOCUMENT_ENCRYPTION_KEY=
APP_URL=https://localhost:8443
SESSION_SECURE_COOKIE=true

# Email. Defaults send to the Mailpit container; open http://localhost:8025 to read what was sent.
# To send real email, set your provider below. Never commit real credentials.
# Gmail example (needs 2-step verification and an App Password, not your normal password;
# Gmail always sends from the signed-in address):
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_SCHEME=smtp
#   MAIL_USERNAME=you@gmail.com
#   MAIL_PASSWORD=<16-character app password>
#   MAIL_FROM_ADDRESS=you@gmail.com
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=taxvault@localhost
MAIL_FROM_NAME=TaxVault
# Daily notification emails go out at 08:00 in this time zone.
NOTIFICATION_TIMEZONE=Australia/Sydney

# Passphrase protecting backups made by scripts/backup.ps1 (min 16 chars). Store it outside the backups.
BACKUP_PASSPHRASE=
