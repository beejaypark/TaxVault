APP_NAME=TaxVault
APP_ENV=local
APP_KEY=

POSTGRES_DB=taxvault
POSTGRES_USER=taxvault
POSTGRES_PASSWORD=taxvault_dev

REDIS_PASSWORD=
OCR_PROVIDER=local

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
DEV_ADMIN_LOGIN_ENABLED=true
KEYCLOAK_REALM_IMPORT_DIR=./infrastructure/keycloak/realm/local
NGINX_CONFIG_FILE=./infrastructure/docker/nginx/default.local.conf
NGINX_HTTP_PUBLISH=127.0.0.1:8080:80
NGINX_HTTPS_PUBLISH=127.0.0.1:8443:443

KEYCLOAK_URL=http://keycloak:8080/auth
KEYCLOAK_PUBLIC_URL=https://localhost:8443/auth
KEYCLOAK_REALM=taxvault
KEYCLOAK_CLIENT_ID=taxvault-web
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=https://localhost:8443/api/auth/oidc/callback

# Optional Microsoft OneDrive import. Register the redirect URI below in Microsoft Entra ID.
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_TENANT=common
MICROSOFT_GRAPH_REDIRECT_URI=https://localhost:8443/api/document-storage/onedrive/callback

# Optional Google Drive import. Register this redirect URI in Google Cloud OAuth credentials.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://localhost:8443/api/document-storage/google-drive/callback

# Optional Dropbox import. Register this redirect URI in the Dropbox app console.
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=https://localhost:8443/api/document-storage/dropbox/callback

# Document encryption at rest (AES-256-GCM). Generate: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
# If empty, a key is derived from APP_KEY. Losing this key makes stored documents unrecoverable.
DOCUMENT_ENCRYPTION_KEY=
APP_URL=https://localhost:8443
TAXVAULT_ADMIN_NOTIFICATION_EMAIL=admin@example.com
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=30

# Email. Defaults send to the Mailpit container; open http://localhost:8025 to read what was sent.
# To send real email, set your provider below. Never commit real credentials.
# Gmail example (needs 2-step verification and an App Password, not your normal password;
# Gmail always sends from the signed-in address):
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_SCHEME=smtp
#   MAIL_USERNAME=you@gmail.com
#   MAIL_PASSWORD=<16-character app password>
#   MAIL_FROM_ADDRESS=you@gmail.com
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=taxvault@localhost
MAIL_FROM_NAME=TaxVault
# Set this to the real support inbox in production. Local Mailpit uses a test recipient when blank.
TAXVAULT_SUPPORT_EMAIL=
# Daily notification emails go out at 08:00 in this time zone.
NOTIFICATION_TIMEZONE=Australia/Sydney

# Optional live bank feed through Basiq (open banking). Leave BASIQ_API_KEY empty to hide the feature.
# Use the base64 application key from the Basiq dashboard.
BASIQ_API_KEY=
# Optional AI summaries for personalised Tax News. Leave empty to use rule-based recommendations only.
OPENAI_API_KEY=
OPENAI_TAX_NEWS_MODEL=gpt-4o-mini
# Optional alternative providers for personalised Tax News.
ANTHROPIC_API_KEY=
ANTHROPIC_TAX_NEWS_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_TAX_NEWS_MODEL=gemini-2.0-flash

# Passphrase protecting backups made by scripts/backup.ps1 (min 16 chars). Store it outside the backups.
BACKUP_PASSPHRASE=
